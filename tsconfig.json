{
    "compilerOptions": {
        "esModuleInterop": true,
        "skipLibCheck": true,
        "target": "es2025",
        "allowJs": true,
        "moduleDetection": "force",
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "module": "NodeNext",
        "outDir": "dist",
        "lib": [
            "es2025"
        ]
        
    },  
    "include": ["src/**/*"],
    "exclude": ["node_modules", "**/*.spec.ts"]
}